# Telegram (required for live alerts)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional secondary bot: mirror every alert (set both values to enable)
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_ID_2=

# Optional
DRY_RUN=0
# Seconds before each 5m close at which the forming candle is judged and an
# "EARLY (unconfirmed)" alert may be sent (live loop only). 0 = close-only.
EARLY_ALERT_SECONDS=60
# Skip the early pass for a stock whose newest 1m print is older than this
EARLY_MAX_STALE_SECONDS=100
# Seconds after the 5m close before the confirmed scan asks Yahoo
POLL_GRACE_SECONDS=10
# Until this long after the close, a candle is judged only once the stock's 1m
# feed shows a print at/after the close (guards against a half-published candle)
BAR_SETTLE_SECONDS=45
# Max age since 5m bar CLOSE; older entries are dropped, not backfilled
MAX_ALERT_LAG_SECONDS=180
YF_PERIOD_5M=7d
YF_PERIOD_1D=90d
LOG_LEVEL=INFO

# Nifty NEUTRAL but one sector clearly leading: scan that sector LONG (0 = always WAIT).
SECTOR_FOLLOW=1
SECTOR_FOLLOW_MIN_PERSIST=55
SECTOR_FOLLOW_MAX=2
# Sectors your chart shows as SMART$/MARKET/SECTOR/FLOW aligned (scanned first), e.g. PHA,ENE
SF_ALIGNED_SECTORS=

# Futures open interest: off | annotate | require. Needs rows in OI_FILE (Yahoo has no OI).
OI_FILTER=annotate
OI_FILE=data/oi_history.csv
