# Telegram (required for live alerts)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional secondary bot: mirror every alert (set both values to enable)
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_ID_2=

# Optional
DRY_RUN=0
# Seconds before each 5m close at which the forming candle is judged and an
# "EARLY (unconfirmed)" alert may be sent (live loop only). 0 = close-only.
EARLY_ALERT_SECONDS=60
# Skip the early pass for a stock whose newest 1m print is older than this
EARLY_MAX_STALE_SECONDS=100
# Seconds after the 5m close before the confirmed scan asks Yahoo
POLL_GRACE_SECONDS=10
# Until this long after the close, a candle is judged only once the stock's 1m
# feed shows a print at/after the close (guards against a half-published candle)
BAR_SETTLE_SECONDS=45
# Max age since 5m bar CLOSE; older entries are dropped, not backfilled
MAX_ALERT_LAG_SECONDS=180
YF_PERIOD_5M=7d
YF_PERIOD_1D=90d
LOG_LEVEL=INFO

# Nifty NEUTRAL but one sector clearly leading: scan that sector LONG (0 = always WAIT).
SECTOR_FOLLOW=1
SECTOR_FOLLOW_MIN_PERSIST=55
SECTOR_FOLLOW_MAX=2
# Sectors your chart shows as SMART$/MARKET/SECTOR/FLOW aligned (scanned first), e.g. PHA,ENE
SF_ALIGNED_SECTORS=

# Futures open interest: off | annotate | require. Needs rows in OI_FILE (Yahoo has no OI).
OI_FILTER=annotate
OI_FILE=data/oi_history.csv

# ── 1-minute projected scan (bot #3, `python -m nse_scanner live-1m`) ──
# Its own bot/chat: projected (pre-close) alerts must not mix with the
# close-confirmed stream above. Leave empty to print instead of sending.
TELEGRAM_BOT_TOKEN_3=
TELEGRAM_CHAT_ID_3=
# First minute of each 5m candle that may alert (1 = up to 4 min early).
SCAN1M_FIRST_MINUTE=1
# Skip a stock whose newest 1m print is older than this many seconds.
SCAN1M_MAX_STALE_SECONDS=100
# Seconds after a minute boundary before the projection asks Yahoo.
SCAN1M_GRACE_SECONDS=6
# Projected alerts per stock per session (1). A projection that failed its
# close may be retried on a later candle of the same session.
SCAN1M_EARLY_PER_DAY=1
# Sector pick: ledger (reuse the 5m scan's pick) | own | auto
SCAN1M_MARKET_SOURCE=auto
# 1 = also report a projection that did not survive the close (default: silent).
SCAN1M_CANCEL_MESSAGE=0
# 1 = send a short session summary at 15:33.
SCAN1M_SUMMARY=1
# 1m history window for the projection (1d is enough and much lighter).
SCAN1M_1M_PERIOD=1d
# Rule inputs shared with the 5m scan (`python -m nse_scanner live`): both loops
# must read the same OI_FILTER / MAX_ALERT_LAG_SECONDS / BAR_SETTLE_SECONDS.
